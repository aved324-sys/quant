//@version=6
indicator("TQ SPX 0DTE Spread Sim G2", overlay=false, max_bars_back=500)
// Quant Tournament Gen 2 - SPX (SPXW) 0DTE vertical credit spread simulator. MODELED pricing:
// Black-Scholes, IV = VIX1D with a linear skew in moneyness. Signals = Beta (sweep) or Delta (MTF pullback).
// Bar-close signals, spread priced at that close plus slippage. No lookahead. OOS stats hidden unless revealed.
agent = input.string("Beta", "Agent", options=["Beta", "Delta"])
stopMode = input.string("B", "Stop variant", options=["A", "B"])
showOOS = input.bool(false, "Reveal OOS stats (pre-registered: off)")
capital = input.float(100000, "Starting equity")
putSkew = input.float(0.25, "Put IV multiplier per 1% OTM")
callSkew = input.float(0.05, "Call IV reduction per 1% OTM")
slipSpread = input.float(0.10, "Slippage per spread per fill (premium $)")
feeLeg = input.float(1.0, "Fee per contract per leg per side ($)")
oosStart = timestamp("America/New_York", 2026, 8, 1, 0, 0)

tz = "America/New_York"
hh = hour(time, tz)
mi = minute(time, tz)
hhmm = hh * 100 + mi
dInt = year(time, tz) * 10000 + month(time, tz) * 100 + dayofmonth(time, tz)
inRTH = hhmm >= 930 and hhmm < 1600
rthStart = inRTH and (dInt != nz(dInt[1]) or not inRTH[1])
tmin = 960 - (hh * 60 + mi + 5)
Tyr = math.max(tmin, 0) / 390.0 / 252.0

// ---------- session state ----------
var float dH = na
var float dL = na
var float pdH = na
var float pdL = na
var float pdC = na
var float lastRthC = na
var float orH = na
var float orL = na
var float sPV = 0.0
var float sV = 0.0
var float dATR = na
var float rthOpen = na
if rthStart
    if not na(dH)
        tr = math.max(dH, nz(pdC, dH)) - math.min(dL, nz(pdC, dL))
        dATR := na(dATR) ? tr : (dATR * 13 + tr) / 14
        pdH := dH
        pdL := dL
        pdC := lastRthC
    dH := high
    dL := low
    orH := high
    orL := low
    sPV := 0.0
    sV := 0.0
    rthOpen := open
else if inRTH
    dH := math.max(dH, high)
    dL := math.min(dL, low)
    if hhmm < 945
        orH := math.max(orH, high)
        orL := math.min(orL, low)
if inRTH
    sPV += hlc3 * volume
    sV += volume
    lastRthC := close
vwap_ = sV > 0 ? sPV / sV : na
orReady = inRTH and hhmm >= 945
atr = ta.atr(14)

var fomc = array.from(20251210, 20260128, 20260318, 20260429, 20260617, 20260729, 20260916, 20261028, 20261209)
isFomc = array.includes(fomc, dInt)

vix1d = request.security("CBOE:VIX1D", timeframe.period, close, lookahead=barmerge.lookahead_off)
vixH = request.security("CBOE:VIX", timeframe.period, high, lookahead=barmerge.lookahead_off)
add = request.security("USI:ADD", timeframe.period, close, lookahead=barmerge.lookahead_off)
sig = vix1d / 100.0
emRem = close * sig * math.sqrt(math.max(tmin, 0) / 390.0 / 252.0)

// ================= BETA signals (sweep + next-bar confirmation) =================
rsi = ta.rsi(close, 14)
ph = ta.pivothigh(high, 5, 5)
pl = ta.pivotlow(low, 5, 5)
var float lastPH = na
var float lastPHrsi = na
var float lastPL = na
var float lastPLrsi = na
var float lastPLvix = na
if not na(ph)
    lastPH := ph
    lastPHrsi := rsi[5]
if not na(pl)
    lastPL := pl
    lastPLrsi := rsi[5]
    lastPLvix := vixH[5]
var bool usePDH = false
var bool usePDL = false
var bool useORH = false
var bool useORL = false
if rthStart
    usePDH := false
    usePDL := false
    useORH := false
    useORL := false
f_swUp(float lv, bool used) => not used and not na(lv) and high > lv + syminfo.mintick and close < lv
f_swDn(float lv, bool used) => not used and not na(lv) and low < lv - syminfo.mintick and close > lv
sPDH = f_swUp(pdH, usePDH)
sORH = orReady and f_swUp(orH, useORH)
sPDL = f_swDn(pdL, usePDL)
sORL = orReady and f_swDn(orL, useORL)
bearSweep = inRTH and hhmm >= 945 and (sPDH or sORH)
bullSweep = inRTH and hhmm >= 945 and (sPDL or sORL)
if bearSweep
    usePDH := usePDH or sPDH
    useORH := useORH or sORH
if bullSweep
    usePDL := usePDL or sPDL
    useORL := useORL or sORL
bearDiv = not na(lastPH) and high > lastPH and rsi < lastPHrsi
bullDivRsi = not na(lastPL) and low < lastPL and rsi > lastPLrsi
bullDivVix = not na(lastPLvix) and vixH < lastPLvix
knife = (not na(pdC) and not na(dATR) and rthOpen - pdC < -dATR) or close < vwap_ - 1.5 * atr
var bool pendBear = false
var bool pendBull = false
var float swHi = na
var float swLo = na
var float swMid = na
confBear = pendBear and close < swMid
confBull = pendBull and close > swMid
bConfHi = swHi
bConfLo = swLo
pendBear := false
pendBull := false
if bearSweep and bearDiv
    pendBear := true
    swHi := high
    swMid := hl2
if bullSweep and (bullDivRsi or bullDivVix) and not knife
    pendBull := true
    swLo := low
    swMid := hl2

// ================= DELTA signals (HTF regime from confirmed closes + 5m pullback) =================
ema20 = ta.ema(close, 20)
ema50 = ta.ema(close, 50)
var float h1C = na
var float h1E20 = na
var float h1E50 = na
var float m15E9 = na
var float m15E21 = na
var int bearCnt15 = 0
if timeframe.change("60")
    c1 = close[1]
    h1C := c1
    h1E20 := na(h1E20) ? c1 : h1E20 + 2.0 / 21.0 * (c1 - h1E20)
    h1E50 := na(h1E50) ? c1 : h1E50 + 2.0 / 51.0 * (c1 - h1E50)
if timeframe.change("15")
    c2 = close[1]
    m15E9 := na(m15E9) ? c2 : m15E9 + 2.0 / 10.0 * (c2 - m15E9)
    m15E21 := na(m15E21) ? c2 : m15E21 + 2.0 / 22.0 * (c2 - m15E21)
    bearCnt15 := m15E9 < m15E21 ? bearCnt15 + 1 : 0
addUp = add > 0 and add > add[3]
addDn = add < 0 and add < add[3]
biasLong = h1E20 > h1E50 and h1C > h1E20 and m15E9 > m15E21
biasShort = h1E20 < h1E50 and h1C < h1E20 and h1C < h1E50 and bearCnt15 >= 2
pbL = low <= ema20 and close > ema50
pbS = high >= ema20 and close < ema50
dLong = biasLong and addUp and pbL[1] and close > high[1]
dShort = biasShort and addDn and pbS[1] and close < low[1]
pbLow = math.min(low, low[1])
pbHigh = math.max(high, high[1])

// ================= options math =================
f_ncdf(float x) =>
    float z = math.abs(x) / math.sqrt(2.0)
    float t = 1.0 / (1.0 + 0.3275911 * z)
    float y = 1.0 - (((((1.061405429 * t - 1.453152027) * t) + 1.421413741) * t - 0.284496736) * t + 0.254829592) * t * math.exp(-z * z)
    x >= 0 ? 0.5 * (1.0 + y) : 0.5 * (1.0 - y)
f_iv(float S, float K, float base, bool isPut) =>
    float m = isPut ? (S - K) / S * 100.0 : (K - S) / S * 100.0
    float mult = isPut ? 1.0 + putSkew * m : 1.0 - callSkew * m
    base * math.max(mult, 0.6)
f_bs(float S, float K, float T, float iv, bool isPut) =>
    float px = 0.0
    float dl = 0.0
    if T <= 0.0000001 or iv <= 0
        px := isPut ? math.max(K - S, 0) : math.max(S - K, 0)
        dl := isPut ? (S < K ? -1.0 : 0.0) : (S > K ? 1.0 : 0.0)
    else
        float sd = iv * math.sqrt(T)
        float d1 = (math.log(S / K) + 0.5 * iv * iv * T) / sd
        float d2 = d1 - sd
        if isPut
            px := K * f_ncdf(-d2) - S * f_ncdf(-d1)
            dl := f_ncdf(d1) - 1.0
        else
            px := S * f_ncdf(d1) - K * f_ncdf(d2)
            dl := f_ncdf(d1)
    [px, dl]
f_spread(float S, float Ks, float Kl, bool isPut, float T, float base) =>
    [ps, dlS] = f_bs(S, Ks, T, f_iv(S, Ks, base, isPut), isPut)
    [pk, dlL] = f_bs(S, Kl, T, f_iv(S, Kl, base, isPut), isPut)
    ps - pk
f_findShort(float S, float limitK, bool isPut, float T, float base, float dMax) =>
    float K0 = isPut ? math.floor(limitK / 5.0) * 5.0 : math.ceil(limitK / 5.0) * 5.0
    float found = na
    float fdl = na
    for i = 0 to 160
        float Ki = isPut ? K0 - 5.0 * i : K0 + 5.0 * i
        [p, dl] = f_bs(S, Ki, T, f_iv(S, Ki, base, isPut), isPut)
        if math.abs(dl) <= dMax
            found := Ki
            fdl := dl
            break
    [found, fdl]
f_intr(float S, float Ks, float Kl, bool isPut) =>
    isPut ? math.max(Ks - S, 0) - math.max(Kl - S, 0) : math.max(S - Ks, 0) - math.max(S - Kl, 0)

// ================= stats store: [period 0 = IS, 1 = OOS] x 27 fields =================
NF = 27
var st = array.new_float(2 * NF, 0.0)
if barstate.isfirst
    array.set(st, 12, capital)
    array.set(st, 13, capital)
    array.set(st, NF + 12, capital)
    array.set(st, NF + 13, capital)
f_g(int p, int i) => array.get(st, p * NF + i)
f_add(int p, int i, float v) => array.set(st, p * NF + i, array.get(st, p * NF + i) + v)
per = time >= oosStart ? 1 : 0
var int firstDate = na
if na(firstDate) and not na(vix1d)
    firstDate := dInt

// ---------- daily P&L for Sharpe ----------
var float dayPnl = 0.0
var int dayPer = 0
var bool dayStarted = false
if rthStart
    if dayStarted
        f_add(dayPer, 15, dayPnl)
        f_add(dayPer, 16, dayPnl * dayPnl)
        f_add(dayPer, 17, 1.0)
    dayPnl := 0.0
    dayPer := per
    dayStarted := true

// ================= position management =================
var bool inPos = false
var bool posPut = false
var float pKs = na
var float pKl = na
var float pC = na
var float pN = na
var float pInv = na
var int pPer = 0
var int pEntryT = 0
bool exitNow = false
float exitV = na
bool isSettle = false
int reason = 0
if inPos and rthStart
    exitNow := true
    isSettle := true
    reason := 3
    exitV := f_intr(close[1], pKs, pKl, posPut)
else if inPos
    float advS = posPut ? low : high
    float favS = posPut ? high : low
    float vAdv = f_spread(advS, pKs, pKl, posPut, Tyr, sig)
    float vFav = f_spread(favS, pKs, pKl, posPut, Tyr, sig)
    float vCls = f_spread(close, pKs, pKl, posPut, Tyr, sig)
    bool hitA = stopMode == "A" and vAdv >= 2.0 * pC
    bool hitBack = vAdv >= 3.0 * pC
    bool hitB = stopMode == "B" and (posPut ? close < pInv : close > pInv)
    if hitA or hitBack
        exitNow := true
        reason := 2
        exitV := math.max((hitA ? 2.0 : 3.0) * pC, vCls)
    else if hitB
        exitNow := true
        reason := 2
        exitV := vCls
    else if vFav <= 0.5 * pC
        exitNow := true
        reason := 1
        exitV := 0.5 * pC
    else if isFomc and hhmm >= 1350
        exitNow := true
        exitV := vCls
    else if hhmm == 1525
        float dist = posPut ? close - pKs : pKs - close
        bool holdIt = dist / close > 0.006 and vCls <= 0.15 * pC
        if not holdIt
            exitNow := true
            exitV := vCls
    else if hhmm >= 1555
        exitNow := true
        isSettle := true
        reason := 3
        exitV := f_intr(close, pKs, pKl, posPut)
if exitNow
    float slipX = isSettle ? 0.0 : slipSpread
    float fees = 2.0 * pN * feeLeg + (isSettle ? 0.0 : 2.0 * pN * feeLeg)
    float pnl = (pC - exitV - slipX) * 100.0 * pN - fees
    f_add(pPer, 0, 1.0)
    f_add(pPer, 26, pnl)
    if pnl > 0
        f_add(pPer, 1, 1.0)
    f_add(pPer, pnl > 0 ? 2 : 3, math.abs(pnl))
    int sb = posPut ? 4 : 8
    f_add(pPer, sb, 1.0)
    if pnl > 0
        f_add(pPer, sb + 1, 1.0)
        f_add(pPer, sb + 2, pnl)
    else
        f_add(pPer, sb + 3, -pnl)
    f_add(pPer, 12, pnl)
    float eqN = f_g(pPer, 12)
    if eqN > f_g(pPer, 13)
        array.set(st, pPer * NF + 13, eqN)
    float ddN = (f_g(pPer, 13) - eqN) / f_g(pPer, 13) * 100.0
    if ddN > f_g(pPer, 14)
        array.set(st, pPer * NF + 14, ddN)
    f_add(pPer, 18, (time_close - pEntryT) / 60000.0)
    if reason > 0
        f_add(pPer, reason == 1 ? 23 : reason == 2 ? 24 : 25, 1.0)
    dayPnl += pnl
    inPos := false

// ================= entries =================
bool win = agent == "Beta" ? (hhmm >= 1000 and hhmm < 1430 and not (hhmm >= 1200 and hhmm < 1330)) : (hhmm >= 1000 and hhmm < 1530 and not (hhmm >= 1200 and hhmm < 1330))
bool fomcNo = isFomc and hhmm >= 1300
bool goLong = agent == "Beta" ? confBull : dLong
bool goShort = agent == "Beta" ? confBear : dShort
if not inPos and not exitNow and inRTH and win and not fomcNo and not na(sig) and tmin > 10 and (goLong or goShort)
    bool isPut = goLong
    float limitK = na
    float inval = na
    if agent == "Beta"
        limitK := isPut ? math.min(bConfLo, close - 1.25 * emRem) : math.max(bConfHi, close + 1.0 * emRem)
        inval := isPut ? bConfLo : bConfHi
    else
        limitK := isPut ? math.min(pbLow, nz(h1E50, pbLow), close - 1.25 * emRem) : math.max(pbHigh, nz(h1E50, pbHigh), close + 1.0 * emRem)
        inval := isPut ? pbLow - 0.25 * atr : pbHigh + 0.25 * atr
    float dMax = isPut ? 0.15 : 0.20
    f_add(per, 19, 1.0)
    [Ks, dls] = f_findShort(close, limitK, isPut, Tyr, sig, dMax)
    bool pinBad = hhmm >= 1430 and not na(Ks) and math.abs(Ks - close) / close <= 0.005
    if na(Ks) or math.abs(dls) < 0.10 or pinBad
        f_add(per, 20, 1.0)
    else
        float bestW = na
        float bestC = na
        float bestN = na
        bool floorFail = false
        bool budgetFail = false
        float eqP = f_g(per, 12)
        for w in array.from(15.0, 10.0, 5.0)
            if na(bestW)
                float Kl = isPut ? Ks - w : Ks + w
                float cr = f_spread(close, Ks, Kl, isPut, Tyr, sig) - slipSpread
                bool okF = cr >= math.max(0.10 * w, 0.85 * math.abs(dls) * w)
                float ml = (w - cr) * 100.0
                float nn = math.floor(eqP * 0.01 / ml)
                if not okF
                    floorFail := true
                else if nn < 1
                    budgetFail := true
                else
                    bestW := w
                    bestC := cr
                    bestN := nn
        if na(bestW)
            f_add(per, floorFail ? 21 : 22, 1.0)
        else
            inPos := true
            posPut := isPut
            pKs := Ks
            pKl := isPut ? Ks - bestW : Ks + bestW
            pC := bestC
            pN := bestN
            pInv := inval
            pPer := per
            pEntryT := time_close

// ================= output (last bar values are the report) =================
f_o(int p, float v) => p == 1 and not showOOS ? na : v
f_pf(int p) => f_g(p, 3) > 0 ? f_g(p, 2) / f_g(p, 3) : na
f_spf(int p, int b) => f_g(p, b + 3) > 0 ? f_g(p, b + 2) / f_g(p, b + 3) : na
f_sh(int p) =>
    float n = f_g(p, 17)
    float m = n > 0 ? f_g(p, 15) / n : na
    float v = n > 0 ? f_g(p, 16) / n - m * m : na
    v > 0 ? m / math.sqrt(v) * math.sqrt(252.0) : na
plot(firstDate, "first_date")
plot(f_g(0, 17), "is_days")
plot(f_o(1, f_g(1, 17)), "oos_days")
plot(f_g(0, 0), "is_trades")
plot(f_pf(0), "is_pf")
plot(f_g(0, 26) / capital * 100.0, "is_net_pct")
plot(f_g(0, 0) > 0 ? f_g(0, 1) / f_g(0, 0) * 100.0 : na, "is_winrate")
plot(f_g(0, 4), "is_long_n")
plot(f_g(0, 4) > 0 ? f_g(0, 5) / f_g(0, 4) * 100.0 : na, "is_long_wr")
plot(f_spf(0, 4), "is_long_pf")
plot(f_g(0, 8), "is_short_n")
plot(f_g(0, 8) > 0 ? f_g(0, 9) / f_g(0, 8) * 100.0 : na, "is_short_wr")
plot(f_spf(0, 8), "is_short_pf")
plot(f_g(0, 14), "is_maxdd_pct")
plot(f_sh(0), "is_sharpe")
plot(f_g(0, 0) > 0 ? f_g(0, 18) / f_g(0, 0) : na, "is_avg_hold_min")
plot(f_g(0, 19), "is_signals")
plot(f_g(0, 20), "is_rej_delta_or_pin")
plot(f_g(0, 21), "is_rej_credit_floor")
plot(f_g(0, 22), "is_rej_budget")
plot(f_g(0, 23), "is_exit_pt")
plot(f_g(0, 24), "is_exit_stop")
plot(f_g(0, 25), "is_exit_settle")
plot(f_o(1, f_g(1, 0)), "oos_trades")
plot(f_o(1, f_pf(1)), "oos_pf")
plot(f_o(1, f_g(1, 26) / capital * 100.0), "oos_net_pct")
plot(f_o(1, f_g(1, 0) > 0 ? f_g(1, 1) / f_g(1, 0) * 100.0 : na), "oos_winrate")
plot(f_o(1, f_g(1, 4)), "oos_long_n")
plot(f_o(1, f_spf(1, 4)), "oos_long_pf")
plot(f_o(1, f_g(1, 8)), "oos_short_n")
plot(f_o(1, f_spf(1, 8)), "oos_short_pf")
plot(f_o(1, f_g(1, 14)), "oos_maxdd_pct")
plot(f_o(1, f_sh(1)), "oos_sharpe")
plot(f_o(1, f_g(1, 19)), "oos_signals")
